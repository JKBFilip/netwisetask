{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "AzureStorage": "UseDevelopmentStorage=true"
  },
  "CatFactApi": {
    "BaseUrl": "https://catfact.ninja/"
  },
  "LocalSettings": {
    "OutputDir": "output",
    "FileName": "catfacts.txt"
  },
  "CloudSettings": {
    "ContainerName": "catfacts-backup",
    "BlobName": "cloud-catfacts.txt"
  }
}